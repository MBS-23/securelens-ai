@@ -0,0 +1,226 @@
+# SecureLens taxonomy registry.
+#
+# Each edition records its primary source and the date SecureLens last checked
+# it. For OWASP Top 10 editions, every category lists the CWE identifiers from
+# that category's official "List of Mapped CWEs"; SecureLens derives a
+# finding's Top 10 category from its CWEs using exactly these lists. Nothing in
+# this file comes from memory or secondary sources. When an edition is
+# re-checked, update `verified_on`; when a new edition is published, add it and
+# move the old one to `status: historical` — never edit history in place.
+#
+# Status values: current | historical. Historical editions are always labelled
+# as such wherever SecureLens displays them.
+
+schema_version: 1
+
+frameworks:
+  owasp_top10:
+    name: OWASP Top 10
+    publisher: OWASP Foundation
+    editions:
+      "2025":
+        status: current
+        title: OWASP Top 10:2025
+        source_url: https://top10.owasp.org/2025/
+        verified_on: "2026-09-30"
+        categories:
+          A01:
+            name: Broken Access Control
+            url: https://top10.owasp.org/2025/A01_2025-Broken_Access_Control/
+            cwes: [22, 23, 36, 59, 61, 65, 200, 201, 219, 276, 281, 282, 283, 284, 285, 352, 359, 377, 379, 402,
+                   424, 425, 441, 497, 538, 540, 548, 552, 566, 601, 615, 639, 668, 732, 749, 862, 863, 918, 922,
+                   1275]
+          A02:
+            name: Security Misconfiguration
+            url: https://top10.owasp.org/2025/A02_2025-Security_Misconfiguration/
+            cwes: [5, 11, 13, 15, 16, 260, 315, 489, 526, 547, 611, 614, 776, 942, 1004, 1174]
+          A03:
+            name: Software Supply Chain Failures
+            url: https://top10.owasp.org/2025/A03_2025-Software_Supply_Chain_Failures/
+            cwes: [447, 1035, 1104, 1329, 1357, 1395]
+          A04:
+            name: Cryptographic Failures
+            url: https://top10.owasp.org/2025/A04_2025-Cryptographic_Failures/
+            cwes: [261, 296, 319, 320, 321, 322, 323, 324, 325, 326, 327, 328, 329, 330, 331, 332, 334, 335, 336,
+                   337, 338, 340, 342, 347, 523, 757, 759, 760, 780, 916, 1240, 1241]
+          A05:
+            name: Injection
+            url: https://top10.owasp.org/2025/A05_2025-Injection/
+            cwes: [20, 74, 76, 77, 78, 79, 80, 83, 86, 88, 89, 90, 91, 93, 94, 95, 96, 97, 98, 99, 103, 104, 112,
+                   113, 114, 115, 116, 129, 159, 470, 493, 500, 564, 610, 643, 644, 917]
+          A06:
+            name: Insecure Design
+            url: https://top10.owasp.org/2025/A06_2025-Insecure_Design/
+            cwes: [73, 183, 256, 266, 269, 286, 311, 312, 313, 316, 362, 382, 419, 434, 436, 444, 451, 454, 472,
+                   501, 522, 525, 539, 598, 602, 628, 642, 646, 653, 656, 657, 676, 693, 799, 807, 841, 1021, 1022,
+                   1125]
+          A07:
+            name: Authentication Failures
+            url: https://top10.owasp.org/2025/A07_2025-Authentication_Failures/
+            cwes: [258, 259, 287, 288, 289, 290, 291, 293, 294, 295, 297, 298, 299, 300, 302, 303, 304, 305, 306,
+                   307, 308, 309, 346, 350, 384, 521, 613, 620, 640, 798, 940, 941, 1390, 1391, 1392, 1393]
+          A08:
+            name: Software or Data Integrity Failures
+            url: https://top10.owasp.org/2025/A08_2025-Software_or_Data_Integrity_Failures/
+            cwes: [345, 353, 426, 427, 494, 502, 506, 509, 565, 784, 829, 830, 915, 926]
+          A09:
