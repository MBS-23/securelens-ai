+def _curated(key: str, raw: dict) -> dict[str, dict[str, tuple[Any, ...]]]:
+    out: dict[str, dict[str, tuple[Any, ...]]] = {}
+    for framework, editions in raw.items():
+        if framework == "top10_parent_cwe":
+            continue
+        if not isinstance(editions, dict):
+            raise ValueError(f"catalog {key}: taxonomy.{framework} must map editions to category lists")
+        out[framework] = {str(edition): tuple(entries or ()) for edition, entries in editions.items()}
+    return out
+
+
+def validate() -> list[str]:
+    """Every problem with catalog taxonomy mappings; used by tests and ``securelens-manage check``."""
+    problems: list[str] = []
+    for vc in catalog().values():
+        problems.extend(taxonomy.validate_class(vc))
+    return problems
+
+
 def get(key: str) -> VulnClass:
     entries = catalog()
     if key not in entries:
