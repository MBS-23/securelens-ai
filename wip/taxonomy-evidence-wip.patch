diff --git a/securelens-ai/backend/securelens/taxonomy/__init__.py b/securelens-ai/backend/securelens/taxonomy/__init__.py
new file mode 100644
index 0000000..7f9b5be
--- /dev/null
+++ b/securelens-ai/backend/securelens/taxonomy/__init__.py
@@ -0,0 +1,380 @@
+"""Versioned security taxonomies: OWASP Top 10, API Security Top 10, LLM Top 10.
+
+SecureLens never mixes editions silently. Every mapping is a ``TaxonomyRef``
+that names the framework, the edition, whether that edition is current or
+historical, and *why* the mapping holds (``basis``):
+
+``cwe``
+    One of the finding's CWEs appears in the category's official "List of
+    Mapped CWEs" (OWASP Top 10 only; the lists live in ``registry.yml``).
+``parent_cwe``
+    The catalog opted in to a parent CWE, verified on the CWE site, and that
+    parent appears in the category's official list.
+``curated``
+    A reviewed, class-level mapping. Used for the API and LLM lists, which do
+    not publish CWE mappings, and for the rare Top 10 case the CWE lists cannot
+    express (documented next to the entry in the catalog).
+``lineage``
+    The historical identifier of a curated current mapping, taken from the
+    current edition's published change table.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterable, Mapping, Sequence
+from dataclasses import dataclass, field
+from functools import lru_cache
+from importlib import resources
+from typing import Any, Protocol
+
+import yaml
+
+FRAMEWORK_ORDER = ("owasp_top10", "owasp_api", "owasp_llm")
+BASES = ("cwe", "parent_cwe", "curated", "lineage")
+_CWE_RE = re.compile(r"^\s*(?:CWE-)?(\d{1,5})\s*$", re.IGNORECASE)
+
+
+class TaxonomyError(ValueError):
+    """The registry or a catalog mapping is inconsistent."""
+
+
+@dataclass(frozen=True)
+class Category:
+    framework: str
+    edition: str
+    id: str
+    name: str
+    url: str
+    cwes: frozenset[int] = frozenset()
+    previous: Mapping[str, str] = field(default_factory=dict)
+    note: str | None = None
+
+    @property
+    def label(self) -> str:
+        return f"{self.id}:{self.edition} {self.name}"
+
+
+@dataclass(frozen=True)
+class Edition:
+    framework: str
+    key: str
+    status: str
+    title: str
+    source_url: str
+    verified_on: str
+    categories: Mapping[str, Category]
+    license: str | None = None
+    note: str | None = None
+
+    @property
+    def current(self) -> bool:
+        return self.status == "current"
+
+    def describe(self) -> dict[str, Any]:
+        return {"framework": self.framework, "edition": self.key, "title": self.title, "status": self.status,
+                "source_url": self.source_url, "verified_on": self.verified_on, "license": self.license}
+
+
+@dataclass(frozen=True)
+class Framework:
+    key: str
+    name: str
+    publisher: str
+    editions: Mapping[str, Edition]
+
+    @property
+    def current(self) -> Edition:
+        return next(e for e in self.editions.values() if e.current)
+
+    def ordered_editions(self) -> list[Edition]:
+        """Current edition first, then historical editions from newest to oldest."""
+        newest_first = sorted(self.editions.values(), key=lambda e: e.key, reverse=True)
+        return sorted(newest_first, key=lambda e: not e.current)
+
+
+@dataclass(frozen=True)
+class Registry:
+    frameworks: Mapping[str, Framework]
+    cwe_version: str
+    cwe_verified_on: str
+    cwe_parents: Mapping[int, int]
+
+    def framework(self, key: str) -> Framework:
+        try:
+            return self.frameworks[key]
+        except KeyError:
+            raise TaxonomyError(f"unknown taxonomy framework: {key}") from None
+
+    def edition(self, framework: str, edition: str) -> Edition:
+        fw = self.framework(framework)
+        try:
+            return fw.editions[str(edition)]
+        except KeyError:
+            raise TaxonomyError(f"unknown edition {edition} of {framework}") from None
+
+    def category(self, framework: str, edition: str, category_id: str) -> Category:
+        ed = self.edition(framework, edition)
+        try:
+            return ed.categories[category_id]
+        except KeyError:
+            raise TaxonomyError(f"unknown category {category_id} in {framework} {edition}") from None
+
+
+@dataclass(frozen=True)
+class TaxonomyRef:
+    framework: str
+    edition: str
+    id: str
+    name: str
+    status: str
+    basis: str
+    via: str | None = None
+    url: str | None = None
+
+    @property
+    def label(self) -> str:
+        return f"{self.id}:{self.edition} {self.name}"
+
+    @property
+    def historical(self) -> bool:
+        return self.status == "historical"
+
+    def to_dict(self) -> dict[str, Any]:
+        return {"framework": self.framework, "edition": self.edition, "id": self.id, "name": self.name,
+                "label": self.label, "status": self.status, "historical": self.historical, "basis": self.basis,
+                "via": self.via, "url": self.url}
+
+
+class MappedClass(Protocol):
+    """What the mapper needs from a catalog vulnerability class."""
+
+    key: str
+    engine: Any
+    cwe: tuple[str, ...]
+    top10_parent_cwe: str | None
+    curated: Mapping[str, Mapping[str, tuple[Any, ...]]]
+
+
+def cwe_number(value: str | int | None) -> int | None:
+    if value is None:
+        return None
+    if isinstance(value, int):
+        return value
+    m = _CWE_RE.match(str(value))
+    return int(m.group(1)) if m else None
+
+
+def _load() -> Registry:
+    raw = yaml.safe_load(resources.files("securelens.taxonomy").joinpath("registry.yml").read_text("utf-8"))
+    frameworks: dict[str, Framework] = {}
+    for fw_key, fw in raw["frameworks"].items():
+        editions: dict[str, Edition] = {}
+        for ed_key, ed in fw["editions"].items():
+            ed_key = str(ed_key)
+            categories: dict[str, Category] = {}
+            for cat_id, cat in ed["categories"].items():
+                categories[cat_id] = Category(
+                    framework=fw_key, edition=ed_key, id=cat_id, name=cat["name"],
+                    url=cat.get("url") or ed["source_url"],
+                    cwes=frozenset(int(c) for c in cat.get("cwes", [])),
+                    previous={str(k): v for k, v in (cat.get("previous") or {}).items()},
+                    note=cat.get("note"),
+                )
+            editions[ed_key] = Edition(
+                framework=fw_key, key=ed_key, status=ed["status"], title=ed["title"], source_url=ed["source_url"],
+                verified_on=str(ed["verified_on"]), categories=categories, license=ed.get("license"),
+                note=" ".join(str(ed["note"]).split()) if ed.get("note") else None,
+            )
+        frameworks[fw_key] = Framework(key=fw_key, name=fw["name"], publisher=fw.get("publisher", ""),
+                                       editions=editions)
+    cwe = raw.get("cwe") or {}
+    reg = Registry(frameworks=frameworks, cwe_version=str(cwe.get("version", "")),
+                   cwe_verified_on=str(cwe.get("verified_on", "")),
+                   cwe_parents={int(k): int(v) for k, v in (cwe.get("parents") or {}).items()})
+    _validate_registry(reg)
+    return reg
+
+
+def _validate_registry(reg: Registry) -> None:
+    for fw in reg.frameworks.values():
+        current = [e for e in fw.editions.values() if e.current]
+        if len(current) != 1:
+            raise TaxonomyError(f"{fw.key} must have exactly one current edition, found {len(current)}")
+        for ed in fw.editions.values():
+            if ed.status not in ("current", "historical"):
+                raise TaxonomyError(f"{fw.key} {ed.key}: invalid status {ed.status}")
+            for cat in ed.categories.values():
+                for prev_edition, prev_id in cat.previous.items():
+                    if prev_edition not in fw.editions or prev_id not in fw.editions[prev_edition].categories:
+                        raise TaxonomyError(f"{cat.label}: lineage points to unknown {prev_id}:{prev_edition}")
+
+
+@lru_cache(maxsize=1)
+def registry() -> Registry:
+    return _load()
+
+
+def _ref(cat: Category, status: str, basis: str, via: str | None = None) -> TaxonomyRef:
+    return TaxonomyRef(framework=cat.framework, edition=cat.edition, id=cat.id, name=cat.name, status=status,
+                       basis=basis, via=via, url=cat.url)
+
+
+def top10_for_cwes(cwes: Iterable[str | int], edition: str | None = None) -> list[TaxonomyRef]:
+    """OWASP Top 10 categories whose official CWE list contains one of ``cwes``."""
+    reg = registry()
+    fw = reg.framework("owasp_top10")
+    editions = [reg.edition("owasp_top10", edition)] if edition else fw.ordered_editions()
+    numbers = list(dict.fromkeys(n for n in (cwe_number(c) for c in cwes) if n is not None))
+    refs: list[TaxonomyRef] = []
+    for ed in editions:
+        for cat in ed.categories.values():
+            hit = next((n for n in numbers if n in cat.cwes), None)
+            if hit is not None:
+                refs.append(_ref(cat, ed.status, "cwe", f"CWE-{hit}"))
+    return refs
+
+
+def _curated_entries(entries: Sequence[Any], cwes: set[int] | None) -> list[str]:
+    """Curated entries are IDs, or ``{id, when_cwe}`` that apply only to findings with one of those CWEs."""
+    out: list[str] = []
+    for entry in entries:
+        if isinstance(entry, str):
+            out.append(entry)
+            continue
+        condition = {cwe_number(c) for c in entry.get("when_cwe", [])}
+        if cwes is None or condition & cwes:
+            out.append(entry["id"])
+    return out
+
+
+def map_finding(classes: Sequence[MappedClass], cwes: Sequence[str]) -> list[TaxonomyRef]:
+    """All taxonomy references for one finding.
+
+    ``classes`` is the finding's vulnerability class followed by the class of
+    the sink it reaches, if any (an LLM output reaching a SQL sink is also SQL
+    injection). ``cwes`` are the finding's own CWEs.
+
+    The web Top 10 is derived from CWEs of application-security classes only:
+    an AI class's own CWEs (e.g. excessive agency) would otherwise produce a
+    technically listed but misleading web category.
+    """
+    reg = registry()
+    if not classes:
+        return []
+    primary = classes[0]
+    appsec = [c for c in classes if str(getattr(c.engine, "value", c.engine)) == "APPSEC"]
+    if appsec and appsec[0] is primary:
+        derive_from = list(cwes)
+    elif appsec:
+        # An AI finding that reaches an application sink: derive from the sink's CWEs, not the AI class's own.
+        ai_only = {cwe_number(x) for x in primary.cwe} - {cwe_number(x) for c in appsec for x in c.cwe}
+        derive_from = [c for c in cwes if cwe_number(c) not in ai_only]
+    else:
+        derive_from = []
+    finding_cwes = {n for n in (cwe_number(c) for c in cwes) if n is not None}
+
+    refs: list[TaxonomyRef] = []
+    seen: set[tuple[str, str, str]] = set()
+
+    def add(ref: TaxonomyRef) -> None:
+        key = (ref.framework, ref.edition, ref.id)
+        if key not in seen:
+            seen.add(key)
+            refs.append(ref)
+
+    top10 = reg.framework("owasp_top10")
+    for ed in top10.ordered_editions():
+        direct = top10_for_cwes(derive_from, ed.key)
+        for ref in direct:
+            add(ref)
+        if not direct:
+            for cls in appsec:
+                parent = cwe_number(cls.top10_parent_cwe)
+                if parent is None:
+                    continue
+                child = next((cwe_number(c) for c in cls.cwe if reg.cwe_parents.get(cwe_number(c) or -1) == parent),
+                             None)
+                for cat in ed.categories.values():
+                    if parent in cat.cwes:
+                        add(_ref(cat, ed.status, "parent_cwe", f"CWE-{parent} (parent of CWE-{child})"))
+        for cls in appsec:
+            for cat_id in _curated_entries(cls.curated.get("owasp_top10", {}).get(ed.key, ()), finding_cwes):
+                add(_ref(reg.category("owasp_top10", ed.key, cat_id), ed.status, "curated"))
+
+    for fw_key in ("owasp_api", "owasp_llm"):
+        fw = reg.framework(fw_key)
+        for cls in classes:
+            for ed_key, entries in cls.curated.get(fw_key, {}).items():
+                ed = reg.edition(fw_key, ed_key)
+                for cat_id in _curated_entries(entries, finding_cwes):
+                    cat = ed.categories[cat_id]
+                    add(_ref(cat, ed.status, "curated"))
+                    for prev_edition, prev_id in cat.previous.items():
+                        prev = fw.editions[prev_edition]
+                        add(_ref(prev.categories[prev_id], prev.status, "lineage", cat.label))
+    order = {k: i for i, k in enumerate(FRAMEWORK_ORDER)}
+    if str(getattr(primary.engine, "value", primary.engine)) == "AISEC":
+        order = {"owasp_llm": 0, "owasp_top10": 1, "owasp_api": 2}
+    return sorted(refs, key=lambda r: (order.get(r.framework, 9), r.historical, r.id))
+
+
+def map_class(cls: MappedClass) -> list[TaxonomyRef]:
+    """Class-level mapping for lessons and catalog pages: every conditional entry is included."""
+    reg = registry()
+    refs = map_finding([cls], list(cls.cwe))
+    seen = {(r.framework, r.edition, r.id) for r in refs}
+    for fw_key, editions in cls.curated.items():
+        for ed_key, entries in editions.items():
+            ed = reg.edition(fw_key, ed_key)
+            for cat_id in _curated_entries(entries, None):
+                if (fw_key, ed_key, cat_id) not in seen:
+                    refs.append(_ref(ed.categories[cat_id], ed.status, "curated"))
+                    seen.add((fw_key, ed_key, cat_id))
+    return refs
+
+
+def current_labels(refs: Iterable[TaxonomyRef | Mapping[str, Any]]) -> list[str]:
+    out: list[str] = []
+    for ref in refs:
+        data = ref.to_dict() if isinstance(ref, TaxonomyRef) else ref
+        if not data.get("historical"):
+            out.append(str(data["label"]))
+    return list(dict.fromkeys(out))
+
+
+def editions_in_use() -> list[dict[str, Any]]:
+    """Every edition SecureLens maps to, current first — printed in report methodology."""
+    reg = registry()
+    out = []
+    for key in FRAMEWORK_ORDER:
+        out.extend(ed.describe() for ed in reg.framework(key).ordered_editions())
+    return out
+
+
+def validate_class(cls: MappedClass) -> list[str]:
+    """Problems with one catalog class's mappings (empty when consistent)."""
+    reg = registry()
+    problems: list[str] = []
+    for fw_key, editions in cls.curated.items():
+        if fw_key not in reg.frameworks:
+            problems.append(f"{cls.key}: unknown framework {fw_key}")
+            continue
+        for ed_key, entries in editions.items():
+            if ed_key not in reg.frameworks[fw_key].editions:
+                problems.append(f"{cls.key}: unknown edition {fw_key} {ed_key}")
+                continue
+            ed = reg.frameworks[fw_key].editions[ed_key]
+            if fw_key == "owasp_llm" and not ed.current:
+                problems.append(f"{cls.key}: map {fw_key} to the current edition only; history follows lineage")
+            for entry in entries:
+                cat_id = entry if isinstance(entry, str) else entry.get("id")
+                if cat_id not in ed.categories:
+                    problems.append(f"{cls.key}: {cat_id} is not a category of {fw_key} {ed_key}")
+                if not isinstance(entry, str) and not entry.get("when_cwe"):
+                    problems.append(f"{cls.key}: conditional entry {cat_id} needs when_cwe")
+    if cls.top10_parent_cwe:
+        parent = cwe_number(cls.top10_parent_cwe)
+        if not any(reg.cwe_parents.get(cwe_number(c) or -1) == parent for c in cls.cwe):
+            problems.append(f"{cls.key}: {cls.top10_parent_cwe} is not a verified parent of {list(cls.cwe)}")
+    return problems
