new file mode 100644
index 0000000..bf7a33b
--- /dev/null
+++ b/securelens-ai/backend/securelens/findings/annotate.py
@@ -0,0 +1,124 @@
+"""Finding annotation: evidence classes, limitations, taxonomy and provenance.
+
+Runs in ``finalize()`` for every finding, whatever produced it, and again on
+the server for imported CLI results, so these fields are always computed by
+SecureLens itself and never trusted from a client.
+"""
+
+from __future__ import annotations
+
+from securelens import taxonomy
+from securelens.enums import EVIDENCE_CLASS_STRENGTH, EvidenceClass, Exploitability, SourceKind, Verification
+from securelens.findings import catalog
+from securelens.findings.model import Evidence, Finding
+
+KIND_CLASS: dict[str, EvidenceClass | None] = {
+    "dataflow": EvidenceClass.STATIC_ANALYSIS_FINDING,
+    "pattern": EvidenceClass.STATIC_ANALYSIS_FINDING,
+    "code": EvidenceClass.STATIC_ANALYSIS_FINDING,
+    "secret": EvidenceClass.STATIC_ANALYSIS_FINDING,
+    "dependency": EvidenceClass.STATIC_ANALYSIS_FINDING,
+    "scanner_output": EvidenceClass.STATIC_ANALYSIS_FINDING,
+    "test_input": EvidenceClass.DYNAMIC_TEST_RESULT,
+    "model_response": EvidenceClass.DYNAMIC_TEST_RESULT,
+    "tool_call": EvidenceClass.DYNAMIC_TEST_RESULT,
+    "retrieval": EvidenceClass.DYNAMIC_TEST_RESULT,
+    "criterion": EvidenceClass.DYNAMIC_TEST_RESULT,
+    "test_result": EvidenceClass.DETERMINISTICALLY_VERIFIED,
+    "ai_analysis": EvidenceClass.AI_ASSISTED_ANALYSIS,
+    "manual": EvidenceClass.USER_REPORTED,
+    "correlation": None,
+}
+
+# Evidence kinds a CLI scan can produce. Imported results containing any other
+# kind are refused: a test result or an AI verdict must come from the server
+# component that produced it, never from uploaded data.
+STATIC_EVIDENCE_KINDS = frozenset({"dataflow", "pattern", "code", "secret", "dependency", "scanner_output",
+                                   "correlation"})
+
+EVIDENCE_CLASS_LABELS = {
+    EvidenceClass.DETERMINISTICALLY_VERIFIED: "Deterministically verified",
+    EvidenceClass.DYNAMIC_TEST_RESULT: "Dynamic test result",
+    EvidenceClass.STATIC_ANALYSIS_FINDING: "Static analysis finding",
+    EvidenceClass.USER_REPORTED: "User reported",
+    EvidenceClass.AI_ASSISTED_ANALYSIS: "AI-assisted analysis",
+    EvidenceClass.INCONCLUSIVE: "Inconclusive",
+    EvidenceClass.FALSE_POSITIVE: "False positive",
+}
+
+
+def evidence_class_for(evidence: Evidence, source_kind: SourceKind) -> EvidenceClass | None:
+    derived = KIND_CLASS.get(evidence.kind)
+    if derived is EvidenceClass.STATIC_ANALYSIS_FINDING and source_kind == SourceKind.LLM_TEST:
+        return EvidenceClass.DYNAMIC_TEST_RESULT
+    return derived
+
+
+def strongest(classes: list[EvidenceClass]) -> EvidenceClass | None:
+    return max(classes, key=lambda c: EVIDENCE_CLASS_STRENGTH[c]) if classes else None
+
+
+def finding_evidence_class(finding: Finding) -> EvidenceClass:
+    if finding.verification == Verification.FALSE_POSITIVE:
+        return EvidenceClass.FALSE_POSITIVE
+    classes = [e.evidence_class for e in finding.evidence if e.evidence_class is not None]
+    best = strongest(classes)
+    if best is not None:
+        return best
+    if finding.source_kind == SourceKind.LLM_TEST:
+        return EvidenceClass.DYNAMIC_TEST_RESULT
+    return EvidenceClass.STATIC_ANALYSIS_FINDING
+
+
+def limitations_for(finding: Finding) -> list[str]:
+    """What this finding's evidence does not show — printed next to the evidence."""
+    out: list[str] = []
+    kind = finding.source_kind
+    external_only = bool(finding.scanners) and not any(s.startswith("securelens") for s in finding.scanners)
+    if kind in (SourceKind.SAST, SourceKind.AI_CODE):
+        out.append("Static analysis only: the code was not executed and exploitation was not attempted.")
+        if finding.exploitability == Exploitability.PROVEN_DATAFLOW:
+            out.append("The data-flow path was traced in source code; runtime conditions such as framework "
+                       "filters, middleware or deployment configuration were not observed.")
+        elif any(e.data.get("origin") == "unknown" for e in finding.evidence if e.kind == "dataflow"):
+            out.append("The origin of the value could not be traced; it may not be attacker-controlled.")
+        elif finding.exploitability == Exploitability.THEORETICAL:
+            out.append("Pattern match: no data flow from untrusted input was established.")
+    elif kind == SourceKind.SECRET:
+        out.append("The value matched a secret pattern. Whether it is a live credential was not checked; "
+                   "SecureLens never sends detected secrets to third parties.")
+    elif kind == SourceKind.DEPENDENCY:
+        out.append("Matched by package version against a published advisory. Whether the vulnerable code is "
+                   "reachable from this application was not analysed.")
+    elif kind == SourceKind.LLM_TEST:
+        out.append("Observed against the configured target at test time; model behaviour can vary between runs "
+                   "and with configuration changes.")
+    if external_only:
+        out.append(f"Reported by {', '.join(finding.scanners)}; SecureLens did not independently confirm it.")
+    if finding.evidence_class == EvidenceClass.AI_ASSISTED_ANALYSIS:
+        out.append("Supported only by AI-assisted analysis; manual verification is required.")
+    return out
+
+
+def _classes_for(finding: Finding) -> list[catalog.VulnClass]:
+    classes: list[catalog.VulnClass] = []
+    for key in (finding.vuln_class, finding.correlation.get("base_class")):
+        if key and catalog.known(str(key)) and all(c.key != key for c in classes):
+            classes.append(catalog.get(str(key)))
+    return classes
+
+
+def annotate(finding: Finding, *, tool_version: str | None = None, language: str | None = None) -> Finding:
+    for evidence in finding.evidence:
+        # Always derived from what the evidence is, never taken from a label it carries.
+        evidence.evidence_class = evidence_class_for(evidence, finding.source_kind)
+    finding.evidence_class = finding_evidence_class(finding)
+    refs = taxonomy.map_finding(_classes_for(finding), finding.cwe)
+    finding.taxonomy = [r.to_dict() for r in refs]
+    finding.owasp = taxonomy.current_labels(refs)
+    if language and not finding.language:
+        finding.language = language
+    if tool_version:
+        finding.tool_version = tool_version
+    finding.limitations = limitations_for(finding)
+    return finding
